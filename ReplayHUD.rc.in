#include "resource.h"
#include <winres.h>

IDI_REPLAYHUD ICON "@REPLAYHUD_ICON_FILE@"

1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "ReplayHUD"
            VALUE "FileDescription", "OBS Replay Buffer notification HUD"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "ReplayHUD"
            VALUE "OriginalFilename", "ReplayHUD.exe"
            VALUE "ProductName", "ReplayHUD"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
